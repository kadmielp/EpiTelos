{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/prepare-llama-runtimes.ps1 && npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "EpiTelos",
    "version": "1.7.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": [
          "$APP/*",
          "**"
        ]
      },
      "path": {
        "all": true
      },
      "http": {
        "all": true,
        "request": true,
        "scope": [
          "http://localhost:11434/*",
          "https://**",
          "https://chat.maritaca.ai/**"
        ]
      },
      "notification": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "resources": ["resources/local_gguf/**/*", "resources/LLAMA_CPP_LICENSE.txt"],
      "windows": { "nsis": { "compression": "zlib" } },
      "identifier": "com.epitelos.dev",
      "icon": [
        "icons/icon.ico",
        "icons/icon.svg"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "EpiTelos",
        "width": 1280,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}
